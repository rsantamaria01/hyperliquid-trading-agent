{
  "name": "hyperliquid-trading-agent",
  "version": "0.4.0",
  "description": "Claude plugin: skills, strategies, and slash commands for trading Hyperliquid perpetuals. The MCP server lives in a separate repo (rsantamaria01/hyperliquid-trading-mcp) — this plugin only ships the Claude-facing layer.",
  "author": {
    "name": "Raul Santamaria"
  },
  "homepage": "https://github.com/rsantamaria01/hyperliquid-trading-agent",
  "license": "MIT",
  "keywords": ["hyperliquid", "trading", "perp", "futures", "crypto", "mcp"],
  "mcpServers": {
    "hyperliquid-trading-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/rsantamaria01/hyperliquid-trading-mcp",
        "hyperliquid-trading-mcp"
      ],
      "env": {
        "HYPERLIQUID_PLUGIN_ENV": "${HOME}/.config/hyperliquid-mcp/.env"
      }
    }
  },
  "skills": ["./skills/setup", "./skills/strategy", "./skills/market-analysis", "./skills/trade-cycle", "./skills/portfolio-review", "./skills/risk-audit"],
  "commands": ["./commands"]
}
