{
  "name": "hyperliquid-trading-agent",
  "version": "0.11.1",
  "description": "Claude plugin: skills, strategies, and slash commands for trading Hyperliquid perpetuals. Auto-spawns the MCP server (hyperliquid-trading-mcp) locally via uvx, installed from git. Plugin holds no secrets — keys live in the workspace .env the server reads.",
  "author": {
    "name": "Raul Santamaria"
  },
  "homepage": "https://github.com/rsantamaria01/hyperliquid-trading-agent",
  "license": "MIT",
  "keywords": ["hyperliquid", "trading", "perp", "futures", "crypto", "mcp"],
  "mcpServers": {
    "hyperliquid-trading-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/rsantamaria01/hyperliquid-trading-mcp@v3.0.4",
        "hyperliquid-trading-mcp"
      ]
    }
  },
  "skills": ["./skills/setup", "./skills/settings", "./skills/strategy", "./skills/market-analysis", "./skills/trade-cycle", "./skills/trade-loop", "./skills/portfolio-review", "./skills/risk-audit"],
  "commands": ["./commands"]
}
