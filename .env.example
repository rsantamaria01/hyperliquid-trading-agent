# === Required ===
HYPERLIQUID_PRIVATE_KEY=0x_your_agent_private_key   # Agent/API wallet — signer only, cannot withdraw
HYPERLIQUID_VAULT_ADDRESS=0x_your_main_wallet       # Main wallet that holds funds

# === Trading mode ===
LIVE_TRADING=false                                  # Set to "true" to send real orders. Otherwise DRY-RUN.
HYPERLIQUID_NETWORK=mainnet                         # mainnet or testnet

# === Risk caps (defaults match the upstream repo) ===
MAX_POSITION_PCT=10                                 # Single position cap as % of equity
MAX_LOSS_PER_POSITION_PCT=20                        # Auto-close any position at this loss %
MAX_LEVERAGE=10                                     # Hard leverage cap
MAX_TOTAL_EXPOSURE_PCT=50                           # Total notional cap as % of equity
DAILY_LOSS_CIRCUIT_BREAKER_PCT=10                   # Daily drawdown to halt new trades
MANDATORY_SL_PCT=5                                  # Auto-SL distance if no SL provided
MAX_CONCURRENT_POSITIONS=10                         # Max open positions
MIN_BALANCE_RESERVE_PCT=20                          # Stop trading below this % of starting balance
